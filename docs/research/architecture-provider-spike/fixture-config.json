{
  "dependencyCruiser": {
    "forbidden": [
      {
        "name": "no-cycles",
        "severity": "error",
        "from": {},
        "to": {
          "circular": true
        }
      },
      {
        "name": "no-unresolved",
        "severity": "error",
        "from": {},
        "to": {
          "couldNotResolve": true
        }
      },
      {
        "name": "domain-must-not-import-ui",
        "severity": "error",
        "from": {
          "path": "^src/domain/"
        },
        "to": {
          "path": "^src/ui/"
        }
      }
    ],
    "options": {
      "doNotFollow": {
        "path": "node_modules"
      },
      "exclude": {
        "path": "\\.test\\.ts$"
      },
      "tsPreCompilationDeps": true,
      "tsConfig": {
        "fileName": "<temp>/fixture/tsconfig.json"
      },
      "enhancedResolveOptions": {
        "extensions": [
          ".ts",
          ".tsx",
          ".js",
          ".json"
        ],
        "conditionNames": [
          "import",
          "require",
          "node",
          "default"
        ]
      }
    }
  },
  "knip": {
