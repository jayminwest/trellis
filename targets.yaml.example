# trellis fleet declaration (SPEC §11).
#
# Copy to `targets.yaml` (gitignored) and edit. Each target is a workspace the
# deterministic core audits — the same measurement `trellis audit <path>`
# runs. A target's failure policy is the declarative `policy` block of its own
# trellis.yaml (SPEC §6.5); per-repo *allowed deltas* for canonical-config
# drift — a separate capability that never enters the sloppiness index — live
# here, not inside the audited repos themselves.

defaults:
  canonicalVersion: "1.0.1" # which standards/ version to compare against

targets:
  - id: warren
    path: /Users/jaymin/Projects/os-eco/warren
    canonical:
      version: "1.0.1" # per-repo override of defaults.canonicalVersion
      allowedDeltas: # files/keys this repo is allowed to diverge on
        - file: biome.json
          reason: "wider line width for generated migrations"
        - file: .github/workflows/ci.yml
          paths: ["jobs.test.strategy"] # structural allow-list within a file
          reason: "matrix-tests the supported runtimes"

  - id: trellis
    path: /Users/jaymin/Projects/os-eco/trellis
    config: ./trellis-fleet.yaml # optional: explicit trellis.yaml (default: discovered at the target root)

  - id: external-repo
    path: ../some-non-oseco-repo
