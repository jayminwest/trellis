{
	"name": "@os-eco/trellis-cli",
	"version": "0.2.1",
	"description": "Offline TypeScript structural audit with a native 0–100 sloppiness index and optional unscored provider evidence",
	"type": "module",
	"bin": {
		"trellis": "./src/cli/main.ts"
	},
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client/index.ts"
	},
	"files": ["src"],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.1.0"
	},
	"keywords": [
		"audit",
		"static-analysis",
		"typescript",
		"complexity",
		"duplication",
		"import-cycles",
		"code-quality",
		"cli",
		"developer-tools"
	],
	"author": "Jaymin West",
	"license": "MIT",
	"homepage": "https://github.com/jayminwest/trellis",
	"bugs": {
		"url": "https://github.com/jayminwest/trellis/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jayminwest/trellis.git"
	},
	"scripts": {
		"test": "bun test --timeout 20000",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"check:size": "bun run scripts/check-file-sizes.ts",
		"check:debt": "bun run scripts/check-debt-markers.ts",
		"check:dups": "bunx jscpd",
		"check:deps": "knip --dependencies",
		"check:agents": "bun run scripts/validate-agents-md.ts --known-missing __golden__ --known-missing targets.yaml --known-missing coverage/lcov.info --known-missing docs/check-all-standard.md",
		"check:coverage": "bun run scripts/check-coverage.ts",
		"check:ci-parity": "bun scripts/check-ci-parity.ts",
		"check:all": "bun scripts/check-all.ts",
		"smoke:package": "bun run scripts/smoke-package.ts",
		"smoke:provider-tools": "bun run scripts/smoke-provider-tools.ts",
		"verify": "bun run check:all",
		"test:coverage": "bun test --coverage --timeout 20000",
		"test:ci": "mkdir -p test-results && bun test --timeout 20000 --coverage --coverage-reporter=lcov --coverage-dir=coverage --reporter=junit --reporter-outfile=test-results/junit.xml",
		"report:test-timing": "bun run scripts/report-test-timing.ts",
		"report:quality-metrics": "bun run scripts/report-quality-metrics.ts",
		"prepare": "[ -e .git ] && git config core.hooksPath scripts/hooks || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "latest",
		"@types/js-yaml": "^4.0.9",
		"dependency-cruiser": "18.3.1",
		"jscpd": "5.2.1",
		"knip": "6.16.1",
		"yaml": "^2.8.2"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"js-yaml": "^4.1.1",
		"typescript": "6.0.3",
		"zod": "^4.4.3"
	}
}
