# trellis — environment configuration
#
# Copy to `.env` and fill values:
#
#     cp .env.example .env
#
# `.env` is gitignored; `.env.example` is committed. Keep it in sync with
# whatever the runtime actually reads.
#
# trellis itself reads no env vars for the deterministic detector path. The
# keys below are consumed only by the investigation layer (SPEC §7, §9), which
# spawns `pi --mode rpc` and forwards these keys to that subprocess via its
# environment (never on argv). Provider/model are selected via CLI flags or
# targets.yaml — see SPEC §9.4.

# ---------------------------------------------------------------------
# Base provider keys (forwarded to the Pi subprocess on every run)
# ---------------------------------------------------------------------

# # Anthropic API key — the default investigation provider.
# # Obtain from your Anthropic dashboard.
ANTHROPIC_API_KEY=

# # Alternative to ANTHROPIC_API_KEY for gateway/proxy auth.
ANTHROPIC_AUTH_TOKEN=

# # Override the Anthropic API base URL (gateways, proxies).
ANTHROPIC_BASE_URL=

# ---------------------------------------------------------------------
# Provider-conditional keys (forwarded only when that provider is selected;
# SPEC §9.4 PI_PROVIDER_ENV_KEYS)
# ---------------------------------------------------------------------

# # provider: openai
OPENAI_API_KEY=
OPENAI_BASE_URL=

# # provider: google (pi reaches Gemini via provider "google")
GEMINI_API_KEY=

# # provider: groq
GROQ_API_KEY=

# # provider: mistral
MISTRAL_API_KEY=

# # provider: deepseek
DEEPSEEK_API_KEY=
